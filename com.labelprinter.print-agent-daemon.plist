<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.labelprinter.print-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gordon/source/repos/LabelPrinter/.venv/bin/python</string>
        <string>/Users/gordon/source/repos/LabelPrinter/print_agent.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gordon/source/repos/LabelPrinter</string>

    <!-- Run at system boot (before login) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Run as root for USB access -->
    <key>UserName</key>
    <string>root</string>

    <key>StandardOutPath</key>
    <string>/Users/gordon/source/repos/LabelPrinter/logs/print-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/gordon/source/repos/LabelPrinter/logs/print-agent-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
