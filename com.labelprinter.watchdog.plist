<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.labelprinter.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gordon/source/repos/LabelPrinter/scripts/watchdog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gordon/source/repos/LabelPrinter</string>

    <!-- Run at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Run every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Also run when waking from sleep -->
    <key>WatchPaths</key>
    <array>
        <string>/var/log/system.log</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/gordon/source/repos/LabelPrinter/logs/watchdog-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/gordon/source/repos/LabelPrinter/logs/watchdog-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
