[Unit]
Description=LabelPrinter Gunicorn Service (TCP)
After=network.target

[Service]
Type=simple
# Paths for this repository
WorkingDirectory=/opt/LabelPrinter
Environment="PATH=/opt/LabelPrinter/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/default/labelprinter

# Bind to TCP port 8000
ExecStart=/opt/LabelPrinter/.venv/bin/gunicorn -w 2 -b 0.0.0.0:8000 server:app

# Run as local user

SupplementaryGroups=lp,bluetooth

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target